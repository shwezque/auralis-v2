# Google Gemini (server-side — used in Vercel serverless functions)
GEMINI_API_KEY=your_gemini_api_key_here

# Redis (used for agent session state persistence)
REDIS_URL=redis://your_redis_instance_url_here

# Google Gemini (optional — client-side fallback for local dev only, not for production)
VITE_GEMINI_API_KEY=optional_browser_fallback_for_local_dev_only
